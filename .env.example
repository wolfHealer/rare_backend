# 复制为 .env 后填写真实值（.env 已在 .gitignore，不会提交）
#   cp .env.example .env

# 必填：MySQL 连接串
MYSQL_DSN=root:YOUR_PASSWORD@tcp(127.0.0.1:3306)/rare_backend?parseTime=true

# 必填：JWT 签名密钥（请使用长随机串，勿使用弱密钥）
JWT_SECRET=change-me-to-a-long-random-string

# 可选
SERVER_ADDR=:8080
JWT_EXPIRE_HOURS=24
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174
GIN_MODE=debug





# 服务监听地址
SERVER_ADDR=:8080

# MySQL 连接串
#MYSQL_DSN=root:password@tcp(127.0.0.1:3306)/rare_backend?parseTime=true
MYSQL_DSN=healer:Zhonghua123456@tcp(rm-wz9cqz4v4ap075evtvo.mysql.cn-shenzhen.rds.aliyuncs.com:3306)/rare_backend?parseTime=true

# JWT（生产环境必须设置强随机密钥）
JWT_SECRET=your-strong-random-secret

# Token 有效期（小时）
JWT_EXPIRE_HOURS=24

# 允许的前端源，逗号分隔
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174

# release | debug | test
GIN_MODE=debug



# OSS（Endpoint 地域须与 Bucket 所在地域一致，勿带 https://）
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET_NAME=your-bucket-name
# OSS_PUBLIC_BASE_URL=https://cdn.example.com  # 可选，自定义访问域名



# .env 文件
SMS_ACCESS_KEY_ID=your-sms-access-key-id
SMS_ACCESS_KEY_SECRET=your-sms-access-key-secret
SMS_SIGN_NAME=你的短信签名
